GIGBID_PORTFOLIO_PATH=data/sample/portfolio_items.json
# Optional local-only document manager: choose an ignored SQLite portfolio path and set
# GIGBID_PORTFOLIO_MANAGE_TOKEN privately (minimum 32 characters). Never expose the API publicly.
# Optional local embeddings: set search to ollama_hybrid after installing the model.
GIGBID_PORTFOLIO_SEARCH=lexical
GIGBID_OLLAMA_URL=http://127.0.0.1:11434
GIGBID_EMBEDDING_MODEL=nomic-embed-text
# Experimental cosine cutoff for dense candidates; not calibrated for real evidence.
GIGBID_MIN_DENSE_SCORE=0.3
# Optional cross-encoder reranking requires ollama_hybrid and the "rerank" extra.
GIGBID_PORTFOLIO_RERANK=none
GIGBID_RERANK_MODEL_PATH=
GIGBID_RERANK_CANDIDATES=20
GIGBID_JOBS_PATH=data/sample/jobs.json
DATABASE_URL=postgresql://gigbid:gigbid-local-only@127.0.0.1:5432/gigbid
# Marketplace adapter: "sample" (static starter jobs) or "gigsim" (local simulator over HTTP).
GIGBID_MARKETPLACE_MODE=sample
GIGSIM_BASE_URL=http://127.0.0.1:8100
GIGSIM_API_TOKEN=
# Simulator server settings (python -m gigsim_local); tokens are for synthetic data only.
GIGSIM_USER_TOKENS=gigsim-dev-token:dev-user
GIGSIM_ADMIN_TOKEN=
GIGSIM_SEED=1234
GIGBID_MARKETPLACE_DB=data/local/marketplace.sqlite3
GIGBID_MARKETPLACE_RATE_LIMIT=20
GIGBID_USER_ID=local-user
