          "SampleJob": {
            "additionalProperties": false,
            "properties": {
              "budget": {
                "$ref": "#/$defs/Budget"
              },
              "category": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Category"
              },
              "client_id": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Client Id"
              },
              "connects_cost": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Connects Cost"
              },
              "data_kind": {
                "const": "synthetic",
                "default": "synthetic",
                "title": "Data Kind",
                "type": "string"
              },
              "description": {
                "title": "Description",
                "type": "string"
              },
              "duration_days": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Duration Days"
              },
              "job_id": {
                "title": "Job Id",
                "type": "string"
              },
              "posted_at_hour": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Posted At Hour"
              },
              "required_skills": {
                "items": {
                  "type": "string"
                },
                "title": "Required Skills",
                "type": "array"
              },
              "screening_questions": {
                "items": {
                  "type": "string"
                },
                "title": "Screening Questions",
                "type": "array"
              },
              "title": {
                "title": "Title",
                "type": "string"
              },
              "warning_signals": {
                "items": {
                  "type": "string"
                },
                "title": "Warning Signals",
                "type": "array"
              }
            },
            "required": [
              "job_id",
              "title",
              "description",
              "budget"
            ],
            "title": "SampleJob",
            "type": "object"
          }
        },
        "properties": {
          "job": {
            "anyOf": [
              {
                "$ref": "#/$defs/SampleJob"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "job"
        ],
        "title": "JobLookupResult",
        "type": "object"
      }
    },
