{
  "marketplace": [
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": false
      },
      "description": "Create a proposal draft only; defaults to a dry-run preview and never submits.",
      "inputSchema": {
        "properties": {
          "cover_letter": {
            "maxLength": 20000,
            "minLength": 1,
            "title": "Cover Letter",
            "type": "string"
          },
          "dry_run": {
            "default": true,
            "title": "Dry Run",
            "type": "boolean"
          },
          "idempotency_key": {
            "maxLength": 200,
            "minLength": 8,
            "title": "Idempotency Key",
            "type": "string"
          },
          "job_id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Job Id",
            "type": "string"
          },
          "price": {
            "exclusiveMinimum": 0,
            "maximum": 1000000,
            "title": "Price",
            "type": "number"
          },
          "screening_answers": {
            "anyOf": [
              {
                "items": {
                  "maxLength": 5000,
                  "type": "string"
                },
                "maxItems": 10,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Screening Answers"
          },
          "trace_id": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Trace Id"
          }
        },
        "required": [
          "job_id",
          "cover_letter",
          "price",
          "idempotency_key"
        ],
        "title": "create_proposal_draftArguments",
        "type": "object"
      },
      "name": "create_proposal_draft",
      "outputSchema": {
        "$defs": {
          "DraftRecord": {
            "additionalProperties": false,
            "properties": {
              "connects_cost": {
                "title": "Connects Cost",
                "type": "integer"
              },
              "cover_letter": {
                "title": "Cover Letter",
                "type": "string"
              },
              "created_at": {
                "anyOf": [
                  {
                    "format": "date-time",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Created At"
              },
              "idempotency_key": {
                "title": "Idempotency Key",
                "type": "string"
              },
              "job_id": {
                "title": "Job Id",
                "type": "string"
              },
              "price": {
                "title": "Price",
                "type": "number"
              },
              "screening_answers": {
                "items": {
                  "type": "string"
                },
                "title": "Screening Answers",
                "type": "array"
              },
              "status": {
                "const": "draft",
                "default": "draft",
                "title": "Status",
                "type": "string"
              }
            },
            "required": [
              "job_id",
              "idempotency_key",
              "cover_letter",
              "price",
              "connects_cost"
            ],
            "title": "DraftRecord",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "connects_cost_if_submitted": {
            "title": "Connects Cost If Submitted",
            "type": "integer"
          },
          "connects_spent": {
            "const": 0,
            "default": 0,
            "title": "Connects Spent",
            "type": "integer"
          },
          "draft": {
            "$ref": "#/$defs/DraftRecord"
          },
          "dry_run": {
            "title": "Dry Run",
            "type": "boolean"
          },
          "external_action_taken": {
            "const": false,
            "default": false,
            "title": "External Action Taken",
            "type": "boolean"
          },
          "outcome": {
            "enum": [
              "preview",
              "created",
              "already_exists"
            ],
            "title": "Outcome",
            "type": "string"
          }
        },
        "required": [
          "dry_run",
          "outcome",
          "draft",
          "connects_cost_if_submitted"
        ],
        "title": "ProposalDraftResult",
        "type": "object"
      }
    },
